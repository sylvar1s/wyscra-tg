# Скопируйте этот файл в .env и заполните.

# Токен бота от @BotFather (нужен для всех примеров, кроме 13)
BOT_TOKEN=

# Ваш Telegram id — для /admin (05, 12) и рассылки
ADMIN_ID=

# 07-group-moderator: канал, на который нужно подписаться, чтобы писать в группе
CHANNEL=

# 11-mini-app: https-адрес вашего сервера (например, через cloudflared или ngrok)
WEBAPP_URL=

# 13-userbot: https://my.telegram.org → API development tools
API_ID=
API_HASH=
